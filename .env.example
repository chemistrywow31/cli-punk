# CLI Punk local environment example.
# Copy this file to .env and fill only the values you need.

# Backend and start script ports.
PORT=3000
HOST=127.0.0.1
FRONTEND_PORT=5173
NO_OPEN=0

# Agent session behavior.
# Set to false to create PTY sessions without auto-running the selected agent.
AUTO_RUN_CLAUDE=true

# Optional shell override for PTY sessions.
# CLAUDE_PUNK_SHELL=/bin/zsh

# Backend auth source of truth.
# Put the real local admin token here in repo-root .env.
# The backend also reads backend/.env, but repo-root .env wins when both exist.
# Setting CLAUDE_PUNK_TOKEN or VITE_CLAUDE_PUNK_TOKEN alone does not authorize
# the backend; those are client-side conveniences only.
# Set exactly one high-entropy local admin token before exposing /api or /ws.
# Example generator: openssl rand -base64 32
CLAUDE_PUNK_ADMIN_TOKEN=

# Backward-compatible admin token aliases. Prefer CLAUDE_PUNK_ADMIN_TOKEN.
CLAUDE_PUNK_AUTH_KEY=
CLAUDE_PUNK_DEV_TOKEN=

# Optional auth/audit storage directory. Leave empty to use ~/.claude-punk.
# CLAUDE_PUNK_AUTH_DIR=/absolute/path/to/.claude-punk

# Comma-separated browser origins allowed for cookie-backed requests.
CLAUDE_PUNK_ALLOWED_ORIGINS=http://127.0.0.1:5173

# Browser session cookie SameSite value: lax, strict, or none.
CLAUDE_PUNK_COOKIE_SAMESITE=lax

# CLI client overrides. These tell the CLI what bearer token to send.
# They do not create or authorize a backend token by themselves.
# Prefer `npm --workspace cli start -- login` for local use.
# CLAUDE_PUNK_SERVER=http://127.0.0.1:3000
# CLAUDE_PUNK_TOKEN=

# Legacy local web frontend overrides. VITE_CLAUDE_PUNK_TOKEN is embedded into
# browser code, so do not use it as the authoritative admin token source.
# VITE_BACKEND_WS=ws://127.0.0.1:3000/ws
# VITE_CLAUDE_PUNK_TOKEN=
# VITE_YT_API_KEY=
